# ── Server ────────────────────────────────────────────────────
PORT=9000

# Address or hostname to listen on. Unset: all interfaces.
# Docker Compose forces 0.0.0.0 so Coolify's proxy can reach the container.
# LISTEN_HOST=127.0.0.1

# ── Routing table (per-chargeBoxId) ──────────────────────────
# Path to the JSON routing table. Each charge point is matched by
# its chargeBoxId; unmatched ids fall back to the "default" route.
# See routes.example.json for the schema.
ROUTES_FILE=./routes.json

# Optional absolute host path used by Docker Compose deployments. Unset: ./routes.json.
# ROUTES_HOST_PATH=/path/to/routes.json

# ── Multi-tenant (optional) ───────────────────────────────────
# Tenants are subdomains of this domain: acme.ocpp.example.com -> "acme".
# Per-tenant routes live under "tenants" in the routes file.
# TENANT_BASE_DOMAIN=ocpp.example.com

# Header carrying the hostname the charger dialled, set by a TRUSTED reverse
# proxy that strips any client-supplied value. Unset: the Host header is used.
# TENANT_HOST_HEADER=x-forwarded-host

# ── Limits ────────────────────────────────────────────────────
# Largest WebSocket message (bytes, 1-2147483647) accepted from a charger or
# a CSMS; a bigger one closes that connection with code 1009. Default: 1 MiB.
# A security default, not an OCPP limit (1.6 DataTransfer.data has no maximum
# length): raise it if you exchange large vendor-specific payloads.
# MAX_MESSAGE_BYTES=1048576

# ── Trace archiving (optional) ───────────────────────────────
# Archive every OCPP frame (Open OCPP Trace v1.1 records) in MongoDB.
# Requires an "id" on every backend of the routes file. See README.
# TRACE_ENABLED=false
# Credentials may go in the URI: keep this file private.
# TRACE_MONGODB_URI=mongodb://user:password@mongo.internal:27017/?authSource=admin
# TRACE_MONGODB_DATABASE=ocpp_gateway
# Days each trace is kept (MongoDB TTL index on expiresAt).
# TRACE_RETENTION_DAYS=30
# Traces held in memory while MongoDB is slow or down; more are dropped.
# TRACE_QUEUE_MAX=10000
# Only write into an existing capped ocpp_traces collection, created by you;
# never create it (a dropped collection then stops archiving, not the disk cap).
# Required wherever that cap is what bounds the archive's disk usage.
# TRACE_REQUIRE_CAPPED=false

# ── Logging ───────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# Maximum number of characters for debug payload summaries.
# Leave empty to disable truncation.
LOG_DEBUG_MESSAGE_MAX_LENGTH=120
